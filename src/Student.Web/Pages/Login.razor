@page "/login"
@layout EmptyLayout
@inject ApiClient Api
@inject ClientSessionStore Auth
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>Đăng nhập · CourseFlow</PageTitle>
<div class="login-layout">
    <section class="login-story">
        <a class="brand brand-on-dark" href="/"><span class="brand-mark">CR</span><span>Course<span class="brand-light">Flow</span></span></a>
        <div class="story-copy">
            <span class="eyebrow">CỔNG ĐĂNG KÝ HỌC PHẦN</span>
            <h1>Chủ động chọn<br /><span>lớp học phù hợp.</span></h1>
            <p>Tra cứu lớp học phần, theo dõi chỗ trống và quản lý thời khóa biểu trong một nơi.</p>
        </div>
        <div class="story-footer">© 2026 · Hệ thống đăng ký học phần thời gian thực</div>
    </section>
    <section class="login-form-wrap">
        <div class="login-card">
            <span class="eyebrow">CHÀO MỪNG TRỞ LẠI</span>
            <h2>Đăng nhập</h2>
            <p class="muted">Dùng tài khoản được cấp để tiếp tục.</p>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="notice notice-error" role="alert">@_error</div>
            }
            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="username">Tên đăng nhập</label>
                    <InputText id="username" name="username" class="form-control" @bind-Value="_model.Username" autocomplete="username" placeholder="Ví dụ: student1" />
                    <ValidationMessage For="() => _model.Username" />
                </div>
                <div class="form-field">
                    <label for="password">Mật khẩu</label>
                    <InputText id="password" name="password" class="form-control" type="password" @bind-Value="_model.Password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                    <ValidationMessage For="() => _model.Password" />
                </div>
                <div class="remember-row">
                    <InputCheckbox id="remember-account" class="remember-checkbox" @bind-Value="_rememberAccount" />
                    <label for="remember-account">Ghi nhớ tài khoản</label>
                </div>
                <button class="button button-primary button-wide" type="submit" disabled="@_busy">
                    @(_busy ? "Đang đăng nhập..." : "Đăng nhập")
                    @if (!_busy) { <span aria-hidden="true">→</span> }
                </button>
            </EditForm>
            <p class="login-help">Tài khoản demo được tạo bởi cấu hình môi trường của dự án. Trình duyệt có thể đề xuất lưu mật khẩu sau khi đăng nhập.</p>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly LoginForm _model = new();
    private string? _error;
    private bool _busy;

    private bool _rememberAccount;

    private const string RememberedUsernameKey = "courseflow.remembered-username";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rememberedUsername = await JS.InvokeAsync<string?>("courseFlowStorage.getItem", RememberedUsernameKey);
            if (!string.IsNullOrWhiteSpace(rememberedUsername))
            {
                _model.Username = rememberedUsername;
                _rememberAccount = true;
            }
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // Keep login available when browser storage is disabled.
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.LoginAsync(_model.Username.Trim(), _model.Password);
            await SaveRememberedAccountAsync(_model.Username.Trim());
            Auth.SignIn(new ClientSession(result.ExpiresAt, result.Role, result.StudentId, result.DisplayName));
            var destination = IsLocalReturnUrl(ReturnUrl)
                ? ReturnUrl!
                : result.Role == "Admin" ? "/admin" : "/dashboard";
            Navigation.NavigateTo(destination);
        }
        catch (ApiException exception)
        {
            _error = exception.ErrorCode == "INVALID_CREDENTIALS"
                ? "Tên đăng nhập hoặc mật khẩu chưa đúng."
                : exception.Message;
        }
        catch (HttpRequestException)
        {
            _error = "Không kết nối được máy chủ. Kiểm tra kết nối rồi thử lại.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveRememberedAccountAsync(string username)
    {
        try
        {
            if (_rememberAccount)
                await JS.InvokeVoidAsync("courseFlowStorage.setItem", RememberedUsernameKey, username);
            else
                await JS.InvokeVoidAsync("courseFlowStorage.removeItem", RememberedUsernameKey);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // Login still succeeds when browser storage is disabled.
        }
    }

    private static bool IsLocalReturnUrl(string? value) =>
        !string.IsNullOrWhiteSpace(value) && value.StartsWith('/') && !value.StartsWith("//");

    private sealed class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nhập tên đăng nhập.")]
        [System.ComponentModel.DataAnnotations.StringLength(64)]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nhập mật khẩu.")]
        [System.ComponentModel.DataAnnotations.StringLength(256)]
        public string Password { get; set; } = string.Empty;
    }
}
