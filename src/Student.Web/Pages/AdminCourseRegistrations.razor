@page "/admin/courses/{Id:guid}/registrations"
@attribute [UiAuthorize("Admin")]
@inject ApiClient Api

<PageTitle>Danh sách đăng ký · Quản trị CourseFlow</PageTitle>
<div class="page-heading"><div><span class="eyebrow">QUẢN TRỊ LỚP</span><h1>Sinh viên đã đăng ký</h1><p class="muted">Thông tin sinh viên được nối từ identity service.</p></div><a class="button button-secondary" href="/admin/courses">← Danh sách lớp</a></div>
@if (_loading) { <div class="loading">Đang tải đăng ký...</div> }
else if (_error is not null) { <div class="notice notice-error">@_error <button class="text-button" @onclick="LoadAsync">Thử lại</button></div> }
else if (_result is { Items.Count: 0 }) { <div class="empty-state"><h2>Chưa có đăng ký</h2></div> }
else if (_result is not null)
{
    <section class="content-panel table-panel"><div class="panel-heading"><div><span class="eyebrow">DANH SÁCH</span><h2>@_result.TotalCount đăng ký</h2></div></div>
        <div class="table-scroll"><table class="admin-table"><thead><tr><th>Mã SV</th><th>Họ tên</th><th>Email</th><th>Trạng thái</th><th>Ngày đăng ký</th><th>Ngày hủy</th></tr></thead><tbody>
        @foreach (var item in _result.Items) { <tr><td>@(item.StudentCode ?? "Không có hồ sơ")</td><td>@(item.FullName ?? "—")</td><td>@(item.Email ?? "—")</td><td>@(item.Status == "Active" ? "Đang học" : "Đã hủy")</td><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@(item.CancelledAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td></tr> }
        </tbody></table></div>
        <div class="pagination"><button class="button button-secondary" disabled="@(_page <= 1)" @onclick="PreviousPage">← Trước</button><span>Trang @_page</span><button class="button button-secondary" disabled="@(_result.Items.Count < _result.PageSize)" @onclick="NextPage">Tiếp →</button></div>
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private PagedResult<CourseRegistrationDto>? _result;
    private bool _loading = true;
    private int _page = 1;
    private string? _error;
    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try { _result = await Api.GetCourseRegistrationsAsync(Id, _page, 25); }
        catch (ApiException exception) { _error = exception.Message; }
        catch (HttpRequestException) { _error = "Không kết nối được máy chủ."; }
        finally { _loading = false; }
    }
    private async Task PreviousPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
}
