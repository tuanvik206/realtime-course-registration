@page "/my-registrations"
@page "/history"
@attribute [UiAuthorize("Student")]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(_history ? "Lịch sử đăng ký" : "Học phần của tôi") · CourseFlow</PageTitle>
<div class="page-heading">
    <div><span class="eyebrow">@(_history ? "THEO DÕI THAY ĐỔI" : "KẾ HOẠCH HỌC TẬP")</span><h1>@(_history ? "Lịch sử đăng ký" : "Học phần của tôi")</h1><p class="muted">@(_history ? "Các lần đăng ký và hủy được lưu lại để bạn tra cứu." : "Danh sách học phần đang có hiệu lực.")</p></div>
    @if (!_history) { <a class="button button-primary" href="/courses">Tìm thêm lớp →</a> }
</div>
<div class="toolbar-row">
    <div class="segmented">
        <a class="@(!_history ? "selected" : "")" href="/my-registrations">Đang học</a>
        <a class="@(_history ? "selected" : "")" href="/history">Lịch sử</a>
    </div>
    @if (!_history && _registrations is not null)
    {
        <span class="muted">Tổng @_registrations.TotalCount lớp đang học</span>
    }
</div>
@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice @(_isError ? "notice-error" : "notice-success")" role="status">@_message</div>
}
@if (_loading)
{
    <div class="loading">Đang tải học phần...</div>
}
else if (_error is not null)
{
    <div class="notice notice-error">@_error <button class="text-button" @onclick="LoadAsync">Thử lại</button></div>
}
else if (_registrations is { Items.Count: 0 })
{
    <div class="empty-state"><span>▤</span><h2>@(_history ? "Chưa có lịch sử đăng ký" : "Bạn chưa đăng ký học phần nào")</h2><p>Những lớp đã đăng ký sẽ xuất hiện ở đây.</p><a class="button button-primary" href="/courses">Duyệt danh sách lớp</a></div>
}
else if (_registrations is not null)
{
    <div class="registration-list">
        @foreach (var registration in _registrations.Items)
        {
            <article class="registration-row">
                <div class="registration-mark">@(registration.Status == "Active" ? "✓" : "↶")</div>
                <div class="registration-main">
                    <div class="registration-title"><span class="course-code">@registration.Course.CourseCode</span><span class="badge @(registration.Status == "Active" ? "badge-open" : "badge-neutral")">@(registration.Status == "Active" ? "Đang học" : "Đã hủy")</span></div>
                    <h2>@registration.Course.SubjectName</h2>
                    <p class="muted">@registration.Course.Credits tín chỉ · @string.Join(" · ", registration.Course.Schedules.Select(item => $"Thứ {item.DayOfWeek}, {item.StartTime[..5]}–{item.EndTime[..5]}"))</p>
                    <small class="muted">Đăng ký @registration.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@if (registration.CancelledAt.HasValue) { <span> · Hủy @registration.CancelledAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span> }</small>
                    @if (_confirmId == registration.RegistrationId)
                    {
                        <div class="confirm-inline"><span>Hủy đăng ký lớp này?</span><button class="button button-danger" @onclick="() => CancelAsync(registration)">Xác nhận hủy</button><button class="button button-quiet" @onclick="() => _confirmId = null">Giữ lại</button></div>
                    }
                </div>
                <div class="registration-actions">
                    <a class="button button-secondary" href="@($"/courses/{registration.CourseSectionId:D}")">Chi tiết</a>
                    @if (registration.Status == "Active")
                    {
                        <button class="button button-danger-outline" disabled="@(_busyId == registration.RegistrationId)" @onclick="() => _confirmId = registration.RegistrationId">
                            @(_busyId == registration.RegistrationId ? "Đang hủy..." : "Hủy lớp")
                        </button>
                    }
                </div>
            </article>
        }
    </div>
    @if (_registrations.TotalCount > _registrations.PageSize)
    {
        <div class="pagination"><button class="button button-secondary" disabled="@(_page <= 1)" @onclick="PreviousPage">← Trước</button><span>Trang @_page</span><button class="button button-secondary" disabled="@(_registrations.Items.Count < _registrations.PageSize)" @onclick="NextPage">Tiếp →</button></div>
    }
}

@code {
    private PagedResult<RegistrationDto>? _registrations;
    private bool _loading = true;
    private string? _error;
    private string? _message;
    private bool _isError;
    private bool _history;
    private int _page = 1;
    private Guid? _busyId;
    private Guid? _confirmId;
    private readonly Dictionary<Guid, Guid> _operationKeys = new();

    protected override async Task OnParametersSetAsync()
    {
        _history = new Uri(Navigation.Uri).AbsolutePath.EndsWith("/history", StringComparison.OrdinalIgnoreCase);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try { _registrations = await Api.GetRegistrationsAsync(_history ? "All" : "Active", _page, 20); }
        catch (ApiException exception) { _error = exception.Message; }
        catch (HttpRequestException) { _error = "Không kết nối được máy chủ."; }
        finally { _loading = false; }
    }

    private async Task CancelAsync(RegistrationDto registration)
    {
        _busyId = registration.RegistrationId;
        _confirmId = null;
        var key = _operationKeys.TryGetValue(registration.RegistrationId, out var existing) ? existing : Guid.NewGuid();
        _operationKeys[registration.RegistrationId] = key;
        try
        {
            await Api.CancelAsync(registration.RegistrationId, key);
            _operationKeys.Remove(registration.RegistrationId);
            _isError = false;
            _message = $"Đã hủy lớp {registration.Course.CourseCode}.";
            await LoadAsync();
        }
        catch (ApiException exception)
        {
            if (exception.StatusCode != System.Net.HttpStatusCode.ServiceUnavailable)
            {
                _operationKeys.Remove(registration.RegistrationId);
            }
            _isError = true;
            _message = exception.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable
                ? "Chưa xác định được kết quả hủy. Tải lại danh sách để kiểm tra; nếu thử lại, dùng cùng mã thao tác."
                : exception.Message;
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            _isError = true;
            _message = "Mất kết nối trong lúc hủy. Danh sách sẽ được tải lại để kiểm tra kết quả.";
            await LoadAsync();
        }
        finally { _busyId = null; }
    }

    private async Task PreviousPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
}
